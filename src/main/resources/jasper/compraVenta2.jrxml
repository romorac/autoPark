					<font size="19" isBold="true"/>
				</textElement>
				<text><![CDATA[COMPRA VENTA AL CONTADO DE VEHICULOS]]></text>
			</staticText>
			<image onErrorType="Blank">
				<reportElement x="24" y="8" width="147" height="70" uuid="7b13c7f9-2073-4231-8bf6-6ce12a40fb0e"/>
