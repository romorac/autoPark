				<reportElement positionType="FixRelativeToBottom" x="193" y="69" width="150" height="18" uuid="a2e4c37a-c463-443d-ac2d-28e96a38a237"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[AUTORIZO LAS FIRMAS]]></text>
			</staticText>
		</band>
