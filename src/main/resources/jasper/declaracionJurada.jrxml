				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font size="11"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA["Por la presente yo <b><b>"+ $P{nombreVendedor}+ "</b>\n</b>de estado civil <b>"+ $P{estadoCivilVendedor} + "</b> de nacionalidad  <b>"+ $P{nacionalidadVendedor}+ "</b> de Profesión <b>"+ $P{profesionVendedor} + "</b> domiciliado(a) en <b>"+ $P{domicilioVendedor}+ "</b> cédula nacional de identidad N° <b>"+ $P{rutVendedor}+ "</b> vengo a declarar bajo de fé de juramento que "+$P{recibiCancele} +" Sr. <b>"+ $P{nombreComerciante}+ "</b> cédula de identidad N° <b>"+ $P{rutComerciante}+ "</b> la suma de <b>$ "+$P{montoNumeroCompra}+".-</b>\n<b>"+ $P{montoCompra} + ".-</b><br>"+$P{formaPago}+". "+$P{obsFormaPago}+"<br>Correspondiente al precio de un <b>"+ $P{tipoVehiculo}+ "</b> Marca: <b>"+ $P{marcaVehiculo} + "</b>, Modelo: <b>"+ $P{modeloVehiculo}+ "</b>, Año: <b>"+ $P{anioVehiculo}+ "</b>, Motor: "+$P{numeroMotor}+", Chasis/Serie: "+$P{chasis}+",  Patente: <b>"+ $P{patenteVehiculo}+ "</b>, Color: <b>"+ $P{colorVehiculo}+ "</b>, Inscripción: <b>"+ $P{inscripcionVehiculo}+ "</b> a nombre de <b>"+ $P{nombreComprador}+"</b>.-<br>"+$P{fijoDeclaracion}+".-"]]></textFieldExpression>
			</textField>
		</band>
		<band height="215">
			<textField>
				<reportElement positionType="Float" x="313" y="70" width="209" height="50" uuid="b1a54d83-51c0-4261-842d-46b12c0f4cb8"/>
				<textElement textAlignment="Center">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Declarante \nFono1: "+$P{telefonoVendedor}+"\nFono2:"+$P{celularVendedor}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="40" y="70" width="200" height="30" uuid="c1f49e00-3e81-4cee-9c0d-ee9a101299d9"/>
