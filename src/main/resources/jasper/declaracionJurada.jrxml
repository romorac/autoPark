				<text><![CDATA[ASESORIAS ADMINISTRATIVAS EN COMPRA Y VENTA DE VEHICULOS  LAZCANO PINTO
AV. PANAMERICANA NORTE #5364
HUECHURABA
				]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="83" width="433" height="30" uuid="f48dbe8d-335b-41b3-b5df-9a5cc8edf971"/>
